# Backend configuration. Locally these go in .dev.vars (git-ignored).
# In production set secrets with `npx wrangler secret put NAME`; never commit real values.

# Required. At least 32 random characters. Signs sessions and encrypts two-factor secrets.
# Generate one:  node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Required. Public origin of the app, used in emailed links and origin checks.
# Local: http://localhost:3000   Live: https://<your-worker>.workers.dev or your domain
APP_URL=

# Required for sign-up, password reset and invitations: resend | cloudflare | console
#   resend      needs RESEND_API_KEY and MAIL_FROM
#   cloudflare  needs a `send_email` binding named EMAIL in wrangler.jsonc and MAIL_FROM
#   console     prints emails to the dev terminal; refused unless APP_URL is localhost
MAIL_TRANSPORT=
MAIL_FROM=
RESEND_API_KEY=

# Google Gemini (AI Studio key). Nothing reads it yet: it is for AI provider execution
# (roadmap Phase 3). Do not put it in a .env file: the build copies .env files into the Worker.
GEMINI_API_KEY=
