// Jobs Worker (background work). Placeholder: no bindings yet and not deployed.
// See docs/backend/backend-plan.md, sections 4 and 14.2.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rankvora-jobs",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // No public address. The web app will call this Worker through a service binding.
  "workers_dev": false,
  "preview_urls": false,
  // "server-only" keeps backend code out of the browser. Jobs is backend too, but outside
  // Next.js the real guard throws at startup, so this build gets an empty file instead.
  "alias": {
    "server-only": "./shims/server-only.ts",
  },
  "observability": {
    "enabled": true,
  },
}
