# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# temporary QA / second build folders (.next-qa, .next-qa-base, ...)
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; .env.example is committed)
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare (OpenNext build output, wrangler state, local worker env)
/.open-next/
/.wrangler/
.dev.vars

# generated by `wrangler types`: 16k lines of runtime types that clash with DOM typings
/cloudflare-env.d.ts
